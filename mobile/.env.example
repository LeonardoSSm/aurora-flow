# Copie este arquivo para .env e ajuste o valor.
# O .env é ignorado pelo Git. Variáveis EXPO_PUBLIC_ ficam visíveis no APK.

# URL base da API
# Para emulador Android: http://10.0.2.2:3000/api/v1
# Para dispositivo físico: substitua pelo IP da sua máquina na rede local
EXPO_PUBLIC_API_BASE_URL=https://flowapi.appstijuca.com.br/api/v1
