NODE_ENV=development
PORT=3000
API_PREFIX=api
# Admin semente local (criado no boot): admin@aurora-flow.local / AuroraFlow@123

DB_HOST=localhost
DB_PORT=5432
DB_USER=formhub
DB_PASSWORD=formhub
DB_NAME=formhub
# DB_SYNC=true forces schema sync on every start — development only, never in production.
DB_SYNC=false
# DB_AUTO_MIGRATE=true runs pending migrations automatically on startup (via TypeORM migrationsRun).
DB_AUTO_MIGRATE=false
# Slow query threshold used by API database metrics.
DB_SLOW_QUERY_THRESHOLD_MS=500

JWT_ACCESS_SECRET=formhub-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=formhub-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Allowed frontend origin for CORS. Use comma-separated values for multiple origins.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Cookie de refresh com atributo "secure". Vazio = só quando NODE_ENV=production.
# Ambiente servido por HTTP (sem TLS) com NODE_ENV=production, como uma homologação pelo IP:
# AUTH_COOKIE_SECURE=false — senão o navegador descarta o cookie e recarregar a página desloga.
# AUTH_COOKIE_SECURE=

# Google Workspace / Sheets
# Domínio do Google Workspace permitido para login OAuth (substituir pelo seu)
GOOGLE_WORKSPACE_DOMAIN=suaempresa.com.br
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Chave AES-256-GCM para criptografar tokens Google at-rest.
# Obrigatória quando GOOGLE_OAUTH_CLIENT_ID estiver definido.
# Deixe vazio em desenvolvimento sem Google OAuth.
# Se definida, deve ser Base64 de pelo menos 32 bytes: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Public CAPTCHA (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# SMTP (automations — send_email action)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Aprovação por link (aprovador externo, sem usuário no sistema): o e-mail com o link usa o SMTP acima.
# Validade do link em horas (padrão 168 = 7 dias; máx. 2160). Sem SMTP em produção a aprovação com aprovador externo é recusada.
# APPROVAL_EXTERNAL_LINK_TTL_HOURS=168

# RabbitMQ queues
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://formhub:formhub@localhost:5672
RABBITMQ_FLOW_SUBMISSION_QUEUE=formhub.flows.submission
RABBITMQ_PREFETCH=5
# RabbitMQ Management HTTP API (used by DLQ monitor). Defaults to localhost:15672.
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_USER=formhub
RABBITMQ_PASSWORD=formhub
# RABBITMQ_PASS (nome do .env da raiz) vale quando RABBITMQ_PASSWORD não está definido.

# Mapa de serviços (Admin › Plataforma) — GET /api/v1/admin/service-map/status.
# Endereços checados pelo backend. Vazios, valem os da rede do docker-compose
# (http://rabbitmq:15672 etc.). O evolution usa SERVICE_MAP_EVOLUTION_URL, senão
# WHATSAPP_EVOLUTION_BASE_URL (o mesmo gateway que o backend chama), senão http://evolution-api:8080.
# Credenciais do painel do RabbitMQ: RABBITMQ_USER / RABBITMQ_PASSWORD.
# Rodando o backend fora do Docker (npm run start:dev), aponte para as portas publicadas
# (ex.: http://localhost:9090); erp-lookup não publica porta e só responde dentro da rede.
SERVICE_MAP_RABBITMQ_URL=
SERVICE_MAP_EVOLUTION_URL=
SERVICE_MAP_ERP_LOOKUP_URL=http://erp-lookup:3100
SERVICE_MAP_PROMETHEUS_URL=http://prometheus:9090
SERVICE_MAP_GRAFANA_URL=http://grafana:3000
SERVICE_MAP_PGADMIN_URL=http://pgadmin:80
# host:porta do MySQL de teste do erp-lookup (perfil erp-dev), checado por TCP.
SERVICE_MAP_ERP_MYSQL_DEV_ADDR=erp-mysql-dev:3306
# Acima deste total de mensagens nas filas, o RabbitMQ aparece como "degradado".
SERVICE_MAP_RABBIT_QUEUE_WARN=1000

# OBRIGATÓRIO EM PRODUÇÃO — protege o endpoint GET /api/v1/metrics.
# Quando configurado, exige header: Authorization: Bearer <valor>
# Configure o mesmo valor em observability/prometheus/metrics_token.
# Sem a variável: endpoint aberto (comportamento aceito em dev local).
# Gere com: openssl rand -hex 32
METRICS_SECRET_TOKEN=

# Grafana admin password (used by docker-compose).
# Generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=troque-em-producao

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# Teto técnico por arquivo (MB). Os formulários não limitam tamanho nem quantidade; isto só protege o servidor.
STORAGE_MAX_FILE_SIZE_MB=100
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ERP Connectors
# Comma-separated list of internal domain names allowed as ERP base URLs.
# Accepts private IPs (10.x, 172.16-31.x, 192.168.x), localhost, and
# hostnames without a public TLD automatically. Use this list only for
# internal domains that do have a TLD-like suffix (e.g. erp.tijuca.local).
# Example: erp.tijuca.local,totvs.corp.internal
ALLOWED_ERP_HOSTS=

# ERP reconciliation (optional safety net for webhook-driven integrations —
# see FlowsErpReconciliationService). Disabled by default; every 30 min,
# calls the given ERP operation template to list pending items and replays
# each one through the given Flow's webhook-handling logic, so items that
# missed the original webhook still get created (idempotency-key protected).
ERP_RECONCILIATION_ENABLED=false
ERP_RECONCILIATION_TEMPLATE_ID=
ERP_RECONCILIATION_FLOW_ID=
# Dot-path to the array of pending items within the list endpoint's JSON
# response body; leave empty if the response body itself is the array.
ERP_RECONCILIATION_ITEMS_PATH=

# WhatsApp provider
WHATSAPP_PROVIDER=mock
WHATSAPP_EVOLUTION_BASE_URL=https://evolution.suaempresa.com
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_INSTANCE=formhub
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_FROM_NUMBER=

# Validador de Etiquetas (IA) — valida lote/fabricação/validade em fotos de
# etiqueta enviadas em campos de fase marcados com "Validar etiqueta com IA".
# Sem API key configurada, a validação é pulada silenciosamente (upload segue normal).
LABEL_VALIDATOR_BASE_URL=https://lopsapi.appstijuca.com.br/api/v1
LABEL_VALIDATOR_API_KEY=
LABEL_VALIDATOR_TIMEOUT_MS=30000

# LOPS IA (integração com agentes de IA) — usada pelo nó "LOPS IA" dos fluxos.
# A URL (LOPS_AI_BASE_URL) vale para listar os agentes e para executá-los. A LOPS_AI_API_KEY é usada
# SÓ para listar os agentes no editor (GET {LOPS_AI_BASE_URL}/models, header X-API-Key) — nunca para
# executar um agente: ao rodar o nó, a chave é a que o usuário informou no próprio nó.
# Sem LOPS_AI_API_KEY a lista de agentes responde 503 com o motivo.
# O timeout do nó (opcional) sobrepõe LOPS_AI_TIMEOUT_MS.
LOPS_AI_BASE_URL=https://lopsapi.appstijuca.com.br/api/v1
LOPS_AI_TIMEOUT_MS=30000
LOPS_AI_API_KEY=

# Notificações (nó "Notificação" dos fluxos — canais in_app, e-mail e WhatsApp).
# O e-mail usa SMTP_* e o WhatsApp usa WHATSAPP_* (acima). Provedor NÃO configurado: fora de produção a notificação
# é apenas registrada (provedor "log"/"mock"); EM PRODUÇÃO ela FALHA com not_configured — nunca finge envio.
# NOTIFICATIONS_ALLOW_MOCK_PROVIDERS=true força o modo simulado também em produção (não recomendado).
NOTIFICATIONS_WORKER_ENABLED=true
# NOTIFICATIONS_ALLOW_MOCK_PROVIDERS=false
# Teto de destinatários por execução do nó e por fluxo/hora (barreira contra envio em massa).
NOTIFICATIONS_MAX_RECIPIENTS_PER_NODE=50
NOTIFICATIONS_MAX_RECIPIENTS_PER_FLOW_PER_HOUR=1000
# Expurgo diário de notificações concluídas mais antigas que N dias (privacidade/retenção).
NOTIFICATIONS_RETENTION_DAYS=90
# Tempo máximo de uma tentativa de envio e de um destinatário "enviando" antes de ser recuperado (ms).
NOTIFICATIONS_SEND_TIMEOUT_MS=20000
NOTIFICATIONS_STALE_PROCESSING_MS=300000
# Envios simultâneos por lote e DDI padrão para telefones sem "+" (Brasil = 55).
NOTIFICATIONS_DISPATCH_CONCURRENCY=5
NOTIFICATIONS_DEFAULT_COUNTRY_CODE=55
