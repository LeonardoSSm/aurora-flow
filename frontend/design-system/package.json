{
  "name": "@tijucas/ui",
  "version": "0.2.0",
  "description": "Visual do Tijuca Flow para outros sistemas: React, Next.js ou HTML/JS puro. Tokens, tema do Tailwind, componentes e classes CSS.",
  "keywords": [
    "tijuca",
    "design-system",
    "tailwind",
    "react",
    "nextjs",
    "tokens",
    "css",
    "vanilla"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "tokens": [
        "./dist/tokens.d.ts"
      ],
      "vanilla": [
        "./dist/vanilla.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./tokens.css": "./css/tokens.css",
    "./components.css": "./css/components.css",
    "./theme.css": "./css/theme.css",
    "./fonts.css": "./css/fonts.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./tokens.json": "./tokens.json",
    "./vanilla.global.js": "./dist/vanilla.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "tailwind-preset.cjs",
    "tokens.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "tokens": "node scripts/generate.ts",
    "build": "node scripts/generate.ts && tsup",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/check-clean.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
