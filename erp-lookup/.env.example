# API erp-lookup — consultas ao banco do ERP (MySQL) para os campos "Lista do ERP".
#
# No Docker, estes valores vêm do docker-compose.yml, que lê as variáveis ERP_LOOKUP_* do .env
# da raiz do projeto (ver a seção "erp-lookup" no compose). Este arquivo serve para rodar a API
# fora do Docker (`npm run start:dev`): copie para `erp-lookup/.env`.
#
# Sem ERP_DB_HOST/ERP_DB_NAME/ERP_DB_USER a API sobe mesmo assim e responde 503 nas consultas.

PORT=3100

# Mesmo valor cadastrado no conector "Consultas ERP" do Tijuca. Gerar com: openssl rand -hex 32
# Mínimo de 32 caracteres. Sem token, nenhuma consulta é autorizada.
LOOKUP_API_TOKEN=

ERP_DB_HOST=
ERP_DB_PORT=3306
ERP_DB_NAME=tijuca_lookup
ERP_DB_USER=tijuca_lookup
ERP_DB_PASSWORD=
ERP_DB_CONNECTION_LIMIT=10
ERP_DB_QUERY_TIMEOUT_MS=5000

# Só desenvolvimento: liga a lista "exemplo" (view criada por dev/seed.sql). Nunca em produção.
FONTE_EXEMPLO_HABILITADA=false

# Para usar o MySQL local do profile erp-dev (docker compose --profile erp-dev up -d):
# ERP_DB_HOST=127.0.0.1
# ERP_DB_PORT=3307
# ERP_DB_PASSWORD=tijuca-lookup-dev
# FONTE_EXEMPLO_HABILITADA=true
